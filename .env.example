# Copy to .env for local development. Every value below is optional.
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///data/feather.db

# Signing secrets. Left unset, random ones are generated into data/secrets.json.
# SECRET_KEY=
# CRON_SECRET=

# Email. With no key nothing is delivered: messages land in data/outbox/.
# RESEND_API_KEY=
EMAIL_PROVIDER=auto
EMAIL_FROM=The Feather Press <onboarding@resend.dev>
# Restrict sending while testing:
# EMAIL_ALLOWED_RECIPIENTS=you@example.com

DELIVERY_HOUR_LOCAL=8
SCHEDULER_ENABLED=true
DEV_TOOLS_ENABLED=true
